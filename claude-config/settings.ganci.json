{
  "_nota": "Ganci di Jarvis per Claude Code. strumenti/installa_claude_config.py li unisce a ~/.claude/settings.json senza toccare i tuoi (copia di sicurezza prima) e sostituisce @@JARVIS@@ con la cartella di Jarvis e @@HOME@@ con la tua casa. Il gancio della lavagna (jarvis_status.py) sta QUI, tra i ganci globali, e non nelle impostazioni del progetto: la chat master parte da casa e le impostazioni del progetto non la vedrebbero. Dal 2026-10-10: stato_avanzamento.py su Stop, PreCompact e SessionEnd aggiorna <memoria>/<spazio>/Stato.md e <memoria>/Sessioni/ (timeout 30 s: SessionEnd ha un budget di 1,5 s se non lo si alza).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"@@HOME@@/.claude/hooks/sessioni.py\" inizio"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"@@HOME@@/.claude/hooks/sessioni.py\" prompt"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"@@JARVIS@@/.claude/hooks/jarvis_status.py\" prompt"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"@@HOME@@/.claude/hooks/sessioni.py\" compatta"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"@@HOME@@/.claude/hooks/stato_avanzamento.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"@@HOME@@/.claude/hooks/sessioni.py\" fine"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"@@HOME@@/.claude/hooks/stato_avanzamento.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"@@HOME@@/.claude/hooks/guardia_comandi.py\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"@@JARVIS@@/.claude/hooks/jarvis_status.py\" pre-agent"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"@@JARVIS@@/.claude/hooks/jarvis_status.py\" post-agent"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"@@JARVIS@@/.claude/hooks/jarvis_status.py\" post"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"@@JARVIS@@/.claude/hooks/jarvis_status.py\" sub-stop"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"@@JARVIS@@/.claude/hooks/jarvis_status.py\" stop"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"@@HOME@@/.claude/hooks/stato_avanzamento.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
